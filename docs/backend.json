{
  "entities": {
    "Lead": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Lead",
      "type": "object",
      "description": "Represents a potential customer (lead) captured through a landing page form.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the lead."
        },
        "name": {
          "type": "string",
          "description": "The lead's name."
        },
        "email": {
          "type": "string",
          "description": "The lead's email address.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "The lead's phone number."
        },
        "clinicName": {
          "type": "string",
          "description": "The lead's clinic name."
        },
        "dateCreated": {
          "type": "string",
          "description": "The date and time when the lead was created.",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "description": "The source of the lead (e.g., 'VSL Opt-in', 'Personalized Demo')."
        }
      },
      "required": [
        "id",
        "email",
        "dateCreated",
        "source"
      ]
    },
    "Clinic": {
      "title": "Clinic",
      "type": "object",
      "description": "Represents a clinic or business signing up for a SORO demo.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Clinic's name." },
        "serviceType": { "type": "string", "enum": ["Odontología", "Estética", "Medicina", "Otro"] },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "openingHours": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri", "description": "URL to the clinic's logo." }
      },
      "required": ["id", "name", "serviceType"]
    },
    "DemoRequest": {
      "title": "DemoRequest",
      "type": "object",
      "description": "Stores all information related to a user's request for a SORO demo.",
      "properties": {
        "id": { "type": "string" },
        "requesterName": { "type": "string" },
        "requesterEmail": { "type": "string", "format": "email" },
        "requesterPhone": { "type": "string" },
        "clinicId": { "type": "string", "$ref": "#/entities/Clinic" },
        "testMode": { "type": "string", "enum": ["qr_connect", "sandbox"] },
        "testObjective": { "type": "string", "enum": ["agenda", "respuestas", "general"] },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed"], "default": "pending" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "requesterEmail", "testMode", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/leads/{leadId}",
        "definition": {
          "entityName": "Lead",
          "schema": { "$ref": "#/backend/entities/Lead" },
          "description": "Stores lead data captured from various landing page forms."
        }
      },
      {
        "path": "/clinics/{clinicId}",
        "definition": {
          "entityName": "Clinic",
          "schema": { "$ref": "#/backend/entities/Clinic" },
          "description": "Stores information about clinics that sign up for a demo."
        }
      },
      {
        "path": "/demo_requests/{requestId}",
        "definition": {
          "entityName": "DemoRequest",
          "schema": { "$ref": "#/backend/entities/DemoRequest" },
          "description": "Tracks each individual demo request flow from start to finish."
        }
      }
    ]
  }
}