rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public creation of leads for capture forms.
    // Reading, updating, or deleting is not allowed for security.
    match /leads/{leadId} {
      allow get: if false;
      allow list: if false;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
    
    // Allow public creation of clinic and demo request data during the onboarding flow.
    // This is necessary for anonymous users to complete the multi-step demo form.
    // More restrictive rules should be applied post-MVP.
    match /clinics/{clinicId} {
      allow create: if true;
      allow read, update, delete: if false; 
    }

    match /demo_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}